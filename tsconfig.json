{
    "compilerOptions": {
      "module": "Node20",
      "target": "ES2020",
      "rootDir": "./src",
      "outDir": "./dist",
      "noImplicitAny": false,
      "sourceMap": false,
      "removeComments": true,
      "moduleResolution": "Node16",
      "isolatedModules": true,
      "lib": ["es2020"],
      "types": ["node", "jest"],
      "skipLibCheck": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "declaration": true
    },
    "exclude": [
      "node_modules",
      "src/**/*.spec.*"
    ],
    "include": [
        "src/**/*"
    ]
  }
